# 🏥 Intake System: Production Configuration Template (v3.2)
# Copy this file to .env.local and adjust for your environment.
# All security-sensitive secrets (DB passwords/GPG) are auto-generated by install.sh/install.bat.

# 🌐 Core Network
PORT=3000
NODE_ENV=production

# 🗄️ Database (Managed by Docker)
# These are internal container URLs. 
# The DB Password is auto-injected from docker/secrets/db_password.txt
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 🧠 AI Service Toggles (Zero Cloud Lock-in)
# ---------------------------------------------------------
# OPTION A: LOCAL-FIRST (Ollama)
# DEFAULT: Enabled. Requires Ollama running in the stack.
NEXT_PUBLIC_OLLAMA_MODEL=gemma2:2b
OLLAMA_BASE_URL=http://ollama:11434

# OPTION B: CLOUD FALLBACK (Gemini)
# Leave blank to disable Cloud fallback (Mandatory for PHI isolation).
# GOOGLE_GENERATIVE_AI_API_KEY=

# 🛡️ Security & Privacy
# Hard-block AI from processing PHI locally vs cloud.
AI_PRIVACY_MODE=strict

# 📂 Storage (NAS Bind Mounts)
# Assets are stored in docker/data/storage by default.
STORAGE_ROOT=./docker/data/storage

# 💎 Forensic Determinism
# Your unique node identifier (Auto-detected if blank)
CLINICAL_NODE_ID=
