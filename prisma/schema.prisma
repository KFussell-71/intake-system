model ClientResume {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  intakeId  String   @map("intake_id") @db.Uuid
  intake    Intake   @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  resumeId  String   @map("resume_id") @db.VarChar(255)
  resumeUrl String   @map("resume_url") @db.Text
  pdfUrl    String?  @map("pdf_url") @db.Text
  version   Int      @default(1)
  isActive  Boolean  @default(true) @map("is_active")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  logs ResumeGenerationLog[]

  @@index([clientId])
  @@index([intakeId])
  @@index([isActive])
  @@index([createdAt])
  @@map("client_resumes")
